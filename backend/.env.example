# Opus Hospital - Environment Variables Template
# 複製此文件為 .env 並填入實際值

# 環境模式
OPUS_ENV=development  # development | production

# 配置文件路徑
CONFIG_PATH=config.development.yaml

# Hugging Face Token (用於下載模型)
HF_TOKEN=your_huggingface_token_here

# CUDA 設置
CUDA_VISIBLE_DEVICES=0

# 資料庫 (如果使用 PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=opus_hospital
# DB_USER=opususer
# DB_PASSWORD=your_secure_password

# Redis (如果使用 Redis 作為緩存)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Grafana 管理密碼 (用於 Docker Compose)
GRAFANA_PASSWORD=admin

# API 金鑰 (如果需要)
# API_KEY=your_api_key_here

# 日誌級別
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# CORS 設置 (開發環境)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 速率限制
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
